__pycache__/
*.pyc
*.egg-info/
.venv/
venv/
dist/
build/
.pytest_cache/

# Installed agent skills/trackers (.agents is the cross-agent convention dir);
# generated by `wfctl install-skills`, not project source.
.agents/
.claude/
.specify/
.wf-skills-manifest.json
.wf-skills-backup/

# Speckit artifacts stay local: the implementation is what ships, and
# committing every spec/plan/tasks tree pollutes the repo.
specs/

# Worktrees workmux nests here — checkouts of this repo, not project source.
wt/

# macOS writes this into any directory Finder opens; untracked files count
# toward `wfctl verify`'s dirty-tree check, so it blocks every verification.
.DS_Store

# claudelint's toolchain. The linter checks the Claude Code files this repo
# ships (.agents/, .claude/, CLAUDE.md); its npm install and result cache are
# tooling, not project source, and a Python package publishes neither.
