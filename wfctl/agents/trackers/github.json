{
  "key_pattern": "\\d+",
  "identity": "@me",
  "verbs": {
    "list": ["gh", "issue", "list", "--state", "open", "--assignee", "{me}", "--limit", "20"],
    "view": ["gh", "issue", "view", "{id}"],
    "close": ["gh", "issue", "close", "{id}", "--comment", "{comment}"],
    "comment": ["gh", "issue", "comment", "{id}", "--body", "{body}"],
    "create": ["bash", ".agents/trackers/github-issue-create.sh", "{title}", "{body}"],
    "label": ["gh", "issue", "edit", "{id}", "--{action}-label", "{label}"],
    "labels": ["gh", "issue", "view", "{id}", "--json", "labels",
               "--jq", ".labels[].name"],
    "fields": ["gh", "issue", "view", "{id}", "--json",
               "labels,assignees,milestone",
               "--jq", "{labels:[.labels[].name],assignees:[.assignees[].login],milestone:(.milestone.title//null)}"],
    "start": ["bash", ".agents/trackers/github-board.sh", "{id}", "In Progress"],
    "stop": ["bash", ".agents/trackers/github-board.sh", "{id}", "Todo",
             "--only-from", "In Progress"]
  },
  "changes": {
    "list": ["gh", "pr", "list", "--state", "open", "--author", "{me}"],
    "view": ["gh", "pr", "view", "{id}"],
    "fields": ["gh", "pr", "view", "{id}", "--json",
               "labels,assignees,milestone,projectItems,reviewRequests",
               "--jq", "{labels:[.labels[].name],assignees:[.assignees[].login],milestone:(.milestone.title//null),projectItems:[.projectItems[].title],reviewRequests:[.reviewRequests[]|.login//.slug]}"]
  }
}
