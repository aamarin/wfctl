# Installed by `wfctl install-skills --agent codex`, and replaced by the next
# install. Put your own rules in another file in this folder.
#
# Codex asks you before the agent turns auto-approve on, since wfctl can't tell
# the agent running the command from you typing it. Codex matches a rule
# against the start of the argument list, so `uv run wfctl` needs its own rule.
# Codex loads this folder only in a project you've marked as trusted. If Codex
# sends approvals to an automatic reviewer instead of you, that reviewer decides,
# since a rule can't require a person.

prefix_rule(
    pattern = ["wfctl", "auto-approve", "on"],
    decision = "prompt",
    justification = "Auto-approve lets the agent answer design gates and run through review stops, so you say yes first.",
    match = ["wfctl auto-approve on"],
    not_match = ["wfctl auto-approve off", "wfctl auto-approve"],
)

prefix_rule(
    pattern = ["uv", "run", "wfctl", "auto-approve", "on"],
    decision = "prompt",
    justification = "Auto-approve lets the agent answer design gates and run through review stops, so you say yes first.",
    match = ["uv run wfctl auto-approve on"],
    not_match = ["uv run wfctl auto-approve off", "uv run wfctl auto-approve"],
)

# Codex also asks before each of the three commands only a person may agree
# to. The rules ship now, but wfctl still needs a terminal for these commands
# in Codex until a session there confirms that Codex asks before a command its
# sandbox allows. None of the three has a `uv run` rule, since each runs the
# installed wfctl on purpose: the branch's own copy may have been edited.

prefix_rule(
    pattern = ["wfctl", "arch", "accept"],
    decision = "prompt",
    justification = "Accepting a record puts a decision in force, so you say yes first.",
    match = ["wfctl arch accept some-record"],
    not_match = ["wfctl arch check-accept some-record", "wfctl arch context"],
)

prefix_rule(
    pattern = ["wfctl", "review", "sign-off"],
    decision = "prompt",
    justification = "A sign-off marks commits reviewed that no review panel read, so you say yes first.",
    match = ["wfctl review sign-off"],
    not_match = ["wfctl review start", "wfctl review check"],
)

prefix_rule(
    pattern = ["wfctl", "arch", "approve-imports"],
    decision = "prompt",
    justification = "Approving imports lets the branch widen what the import check allows, so you say yes first.",
    match = ["wfctl arch approve-imports"],
    not_match = ["wfctl arch context"],
)
