+def test_mirrored_skills_ship_no_wrapper() -> None:
+    """A mirrored skill that also ships `agents/commands/<name>.md` fails here.
+
+    Both files claim one `/name`, and Claude Code picks between them by a rule
+    wfctl does not set: a session on 2026-09-04 got the wrapper, whose
+    `disable-model-invocation` refused the Skill tool for the skill it points at,
+    while another session the same day got the skill and ran it (#170). The
+    wrapper buys nothing back — a skill creates `/name` for a human exactly as a
+    command does — so the pair is pure collision.
+
+    The failure is silent twice over. It ships clean, and it then reproduces on
+    one machine and not the next, which reads as a forgetful agent rather than as
+    packaging. Nothing else compares the two directories, so mirroring a skill
+    and leaving its wrapper behind is a one-line change with no red run.
+
+    Resolved from the installed package for `test_every_declared_mirror_names_a_
+    shipped_skill`'s reason: the autouse `bundle` fixture repoints `BUNDLE_ROOT`
+    at a fixture tree holding none of these names.
+    """
+    import wfctl
+    from wfctl.cli import _MIRRORED_SKILLS
+
+    commands_root = Path(wfctl.__file__).parent / "agents" / "commands"
+    collisions = sorted(n for n in _MIRRORED_SKILLS if (commands_root / f"{n}.md").exists())
+
+    assert collisions == []
+
+
 def test_installed_tree_is_never_a_mirror_source(
     agent_dir: Path, declared_mirror: None
 ) -> None:
