@@ -0,0 +1,141 @@
+"""Codex asks before the agent turns auto-approve on, and Bob Shell can't.
+
+Claude Code gets two ask rules (`tests/test_install_hook_merge.py`). Codex reads
+a rules file with a `prompt` decision from the project's `.codex/rules/`, so
+wfctl ships one. Bob Shell has an allowlist and a deny list but no way to ask,
+so the guard refuses the command when Bob Shell's agent runs it, and the person
+types it in their own terminal instead (`auto-approve-grant-asks-first`).
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import shutil
+import subprocess
+from pathlib import Path
+
+import pytest
+from typer.testing import CliRunner
+
+from wfctl.cli import app
+from wfctl.guard._hook import worktree_guard
+
+runner = CliRunner()
+
+SHIPPED_RULES = Path(__file__).resolve().parent.parent / "wfctl" / "agents" / "codex" / "rules" / "wfctl.rules"
+
+
+def _execpolicy(*command: str) -> dict:
+    result = subprocess.run(
+        ["codex", "execpolicy", "check", "--rules", str(SHIPPED_RULES), "--", *command],
+        capture_output=True, text=True, check=True,
+    )
+    return json.loads(result.stdout)
+
+
+@pytest.mark.skipif(shutil.which("codex") is None, reason="needs the codex CLI")
+@pytest.mark.parametrize(
+    "command",
+    [["wfctl", "auto-approve", "on"], ["uv", "run", "wfctl", "auto-approve", "on"]],
+)
+def test_codex_prompts_before_either_form_of_on(command: list[str]) -> None:
+    """Codex matches a rule against the argument list as an exact prefix, so
+    `uv run` needs a rule of its own, the same reason Claude Code gets two. A
+    rule Codex can't parse fails here rather than loading as no rule at all."""
+    assert _execpolicy(*command).get("decision") == "prompt"
+
+
+@pytest.mark.skipif(shutil.which("codex") is None, reason="needs the codex CLI")
+@pytest.mark.parametrize(
+    "command",
+    [["wfctl", "auto-approve", "off"], ["wfctl", "auto-approve"], ["uv", "run", "wfctl", "auto-approve", "off"]],
+)
+def test_codex_lets_off_and_the_read_through_without_a_prompt(command: list[str]) -> None:
+    """A prompt on `off` would teach people to allowlist wfctl, which takes the
+    prompt off `on` as well."""
+    assert _execpolicy(*command).get("decision") is None
+
+
+def test_install_for_codex_writes_the_rules_file_and_records_it(
+    agent_dir: Path, bundle: Path
+) -> None:
+    """The rules file goes under the project's `.codex/rules/` by its own name,
+    so a rules file the project wrote beside it is left alone, and the manifest
+    records it so `doctor` reports it when it drifts."""
+    rules = bundle / "agents" / "codex" / "rules"
+    rules.mkdir(parents=True)
+    (rules / "wfctl.rules").write_text(SHIPPED_RULES.read_text())
+    repo_root = Path(os.environ["WFCTL_REPO_ROOT"])
+    own = repo_root / ".codex" / "rules" / "mine.rules"
+    own.parent.mkdir(parents=True)
+    own.write_text("# the project's own\n")
+
+    result = runner.invoke(app, ["install-skills", "--agent", "codex", "--yes"])
+
+    assert result.exit_code == 0, result.output
+    assert (repo_root / ".codex" / "rules" / "wfctl.rules").read_text() == SHIPPED_RULES.read_text()
+    assert own.read_text() == "# the project's own\n"
+    manifest = json.loads((repo_root / ".wf-skills-manifest.json").read_text())
+    assert [i["path"] for i in manifest["codex"]["items"]] == [".codex/rules/wfctl.rules"]
+    assert "trusted" in result.output
+
+
+def _payload(command: str, tool_name: str) -> str:
+    return json.dumps({
+        "hook_event_name": "PreToolUse",
+        "tool_name": tool_name,
+        "tool_input": {"command": command},
+        "cwd": os.getcwd(),
+    })
+
+
+@pytest.mark.parametrize("tool_name", ["execute_command", "run_shell_command"])
+@pytest.mark.parametrize(
+    "command",
+    [
+        "wfctl auto-approve on",
+        "uv run wfctl auto-approve on",
+        "FOO=1 wfctl auto-approve on",
+        "cd x && wfctl auto-approve on",
+        'bash -c "wfctl auto-approve on"',
+        "wfctl auto-approve -- on",
+        "uv run --project /repo wfctl auto-approve on",
+    ],
+)
+def test_the_guard_refuses_on_from_bob_shell(
+    command: str, tool_name: str, capsys: pytest.CaptureFixture[str]
+) -> None:
+    """Bob Shell can't ask, so its agent is refused and the refusal says how the
+    person turns the mode on themselves. These are the forms the record says the
+    guard keeps catching in Bob Shell."""
+    assert worktree_guard(_payload(command, tool_name)) == 2
+    err = capsys.readouterr().err
+    assert "Bob Shell" in err
+    assert "your own terminal" in err
+
+
+@pytest.mark.parametrize(
+    "command",
+    ["wfctl auto-approve off", "wfctl auto-approve", "wfctl start --no-auto-approve", "wfctl start"],
+)
+def test_the_guard_lets_bob_shell_turn_the_mode_off_and_read_it(command: str) -> None:
+    """Turning the mode off takes autonomy away, so it never waits on a person."""
+    assert worktree_guard(_payload(command, "execute_command")) == 0
+
+
+@pytest.mark.parametrize(
+    "command",
+    ["rg 'auto-approve on' docs/", "grep -n auto-approve on README.md | wfctl status"],
+)
+def test_the_guard_lets_bob_shell_search_for_the_phrase(command: str) -> None:
+    """A security reviewer found the first version refused any Bob Shell command
+    that mentioned the phrase, which blocks ordinary searches in this repo's own
+    docs. Only a simple command that runs wfctl is refused."""
+    assert worktree_guard(_payload(command, "execute_command")) == 0
+
+
+def test_the_guard_leaves_on_to_claude_codes_prompt() -> None:
+    """Claude Code asks first, so a refusal from the guard would stop the person
+    who said yes to that prompt."""
+    assert worktree_guard(_payload("wfctl auto-approve on", "Bash")) == 0
