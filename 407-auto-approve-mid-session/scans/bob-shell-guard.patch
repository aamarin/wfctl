+# Bob Shell's names for its shell tools. Claude Code calls its one `Bash`, and
+# the payload's `tool_name` is the only field that tells the two agents apart.
+_BOB_SHELL_TOOLS = frozenset({"execute_command", "run_shell_command"})
+
+# Claude Code and Codex ask the person before the agent turns auto-approve on,
+# from the rules `install-skills` writes. Bob Shell has an allowlist and a deny
+# list but no way to ask, so the guard refuses the command there instead, and
+# the person types it in their own terminal (`auto-approve-grant-asks-first`).
+_BOB_GRANT_REFUSAL = (
+    "✗ Bob Shell can't ask you before its agent turns auto-approve on, so wfctl "
+    "blocks it.\n  To turn it on, run `wfctl auto-approve on` in your own terminal."
+)
+
+
+def _bob_grants(command: str) -> bool:
+    """Whether `command` runs `wfctl auto-approve on`.
+
+    Each simple command is checked on its own, and `wfctl` has to come before
+    `auto-approve on` in it, so a search such as `rg auto-approve on docs/`
+    goes through. A command that names wfctl and the phrase together, such as
+    a commit message quoting the command, is still refused. The optional `--`
+    is there because the CLI still reads `on` after it.
+    """
+    import re
+
+    return any(
+        re.search(r"\bwfctl\b.*\bauto-approve\s+(?:--\s+)?on\b", part)
+        for part in re.split(r"&&|\|\||[;|\n]", command)
+    )
+
 
