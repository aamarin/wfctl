+def test_a_roster_that_records_a_running_reviewer_is_not_a_pass() -> None:
+    """A description written while a reviewer is still out is a panel reported
+    as finished before it was.
+
+    Observed 2026-09-06: a session read the roster mid-flight and drafted a PR
+    body around a panel section it then had to reopen. `RUNNING` is honest in
+    the roster and dishonest in a finished description — the same shape as
+    `MISSING`, which is why it is a marker rather than a second rule.
+    """
+    body = (
+        "## Review Panel\n\n"
+        "| # | Reviewer | Finding | Disposition |\n|---|---|---|---|\n"
+        "| 1 | r1 | found a bug | applied |\n\n"
+        "roster: r1 ✓  r2 ✓  r3 RUNNING\n"
+    )
+
+    assert panel_findings(body)
+
+
+def test_each_failure_marker_carries_its_own_remedy() -> None:
+    """`MISSING` and `RUNNING` need opposite responses, and a finding that names
+    the wrong one sends the agent after a reviewer that is working fine.
+
+    The shared sentence they used to share said "ask that reviewer again" — the
+    answer to silence, and the answer that resets a roster the reader only had
+    to re-read.
+    """
+    from wfctl._body import FAILURE_MARKERS
+
+    running = (
+        "## Review Panel\n\n"
+        "| # | Reviewer | Finding | Disposition |\n|---|---|---|---|\n"
+        "| 1 | r1 | found a bug | applied |\n\n"
+        "roster: r1 ✓  r2 RUNNING\n"
+    )
+
+    finding = " ".join(panel_findings(running))
+
+    assert FAILURE_MARKERS["RUNNING"] in finding
+    assert FAILURE_MARKERS["MISSING"] not in finding
+
+
